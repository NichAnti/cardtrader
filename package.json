{
  "name": "cardtrader",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt",
    "test": "vitest run",
    "lint": "oxlint src && effect-tsgo patch --no-typescript --oxlint && oxlint --config .oxlintrc.effect.json --deny-warnings src",
    "check": "oxfmt --check && bun run lint && bun run typecheck && bun run test",
    "prepare": "test -z \"$CI\" && simple-git-hooks || true"
  },
  "dependencies": {
    "@effect/platform-browser": "4.0.0",
    "@foldkit/ui": "0.169.0",
    "effect": "4.0.0",
    "foldkit": "0.169.0"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@effect/tsgo": "0.50.0",
    "@foldkit/devtools": "0.169.0",
    "@foldkit/devtools-mcp": "0.25.0",
    "@foldkit/oxlint-plugin": "0.15.3",
    "@foldkit/vite-plugin": "0.28.0",
    "@tailwindcss/vite": "^4.3.3",
    "alchemy": "^2.0.0-beta.83",
    "happy-dom": "^20.14.5",
    "oxfmt": "^0.66.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "simple-git-hooks": {
    "pre-push": "bun run check"
  }
}
